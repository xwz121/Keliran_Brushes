DATABASE_URL=postgresql://keliran@127.0.0.1:55440/keliran_brushes
DATABASE_URL_UNPOOLED=
# Must differ from keliran.com: it signs enquiry sessions and rate-limit keys.
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3200
# New content preview requires a signed-in CMS user via /api/preview.
CONTENT_PREVIEW_MODE=false
# R2 account and buckets are shared with keliran.com. This site writes media under the
# `brushes/` prefix and enquiry attachments under `brushes/inquiries/`.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
OPENAI_API_KEY=
AI_TRANSLATION_MODEL=gpt-5.6-terra
AI_REVIEW_MODEL=gpt-6-astra
RESEND_API_KEY=
EMAIL_FROM=
SALES_EMAIL=
# The Turnstile widget must list brushes.keliran.com as an allowed hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Must differ from keliran.com.
CRON_SECRET=

# Required for production outside Vercel; Vercel sets VERCEL_ENV itself.
DEPLOYMENT_ENV=development
# One-time CLI bootstrap only; remove after admin:create.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Dedicated PRIVATE bucket (shared with keliran.com): no public domain, no r2.dev access;
# must differ from R2_BUCKET. Its CORS rule must allow PUT from https://brushes.keliran.com.
R2_PRIVATE_BUCKET=
# Optional whole-host redirects to the canonical domain, comma separated. Empty by default.
LEGACY_HOSTS=

# Content migration from keliran.com lives in .env.migration-source (git-ignored); see
# scripts/migration/README.md. Never put the production connection string in this file.
