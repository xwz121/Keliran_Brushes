DATABASE_URL=postgresql://keliran@127.0.0.1:55439/keliran_sealing
DATABASE_URL_UNPOOLED=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000
# New content preview requires a signed-in CMS user via /api/preview.
CONTENT_PREVIEW_MODE=false
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
OPENAI_API_KEY=
AI_TRANSLATION_MODEL=gpt-5.6-terra
AI_REVIEW_MODEL=gpt-6-astra
RESEND_API_KEY=
EMAIL_FROM=
SALES_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=

# Required for production outside Vercel; Vercel sets VERCEL_ENV itself.
DEPLOYMENT_ENV=development
# One-time CLI bootstrap only; remove after admin:create.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Dedicated PRIVATE bucket: no public domain, no r2.dev access; must differ from R2_BUCKET.
R2_PRIVATE_BUCKET=
# Set canonical domain to https://keliran.com when the domain is connected.
LEGACY_HOSTS=sealing.keliran.com,www.keliran.com
