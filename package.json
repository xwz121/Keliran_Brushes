{
  "name": "keliran-brushes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "node scripts/migrate.mjs",
    "seed": "tsx scripts/seed.ts",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "setup:local": "node scripts/setup-local.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "jobs:watch": "tsx scripts/watch-jobs.ts",
    "verify:http": "node scripts/verify-http.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:local": "node scripts/local-env.mjs pnpm dev",
    "build:local": "node scripts/local-env.mjs pnpm build",
    "seed:local": "node scripts/local-env.mjs pnpm seed",
    "review:setup": "node scripts/local-env.mjs pnpm exec tsx scripts/prepare-local-review.ts",
    "contacts:local": "node scripts/local-env.mjs node --import tsx scripts/apply-business-profile.ts",
    "audit:release:local": "node scripts/local-env.mjs node --import tsx scripts/audit-release.ts",
    "checklists:generate": "node --import tsx scripts/generate-checklists.ts",
    "migration:export": "node --import tsx scripts/migration/export-source.ts",
    "migration:import": "node --import tsx scripts/migration/import-target.ts",
    "migration:redirects": "node --import tsx scripts/migration/build-redirect-map.ts",
    "migration:check-redirects": "node scripts/migration/check-redirects.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-sans-jp": "^1.0.0",
    "@ibm/plex-sans-kr": "^1.0.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-resend": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "dotenv": "^16.6.1",
    "graphql": "^16.11.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "openai": "^6.0.0",
    "payload": "3.89.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.0.0",
    "sharp": "0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "monaco-editor>dompurify": "3.4.13",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@swc/core",
      "@parcel/watcher"
    ]
  }
}
